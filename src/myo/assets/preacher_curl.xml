<mujoco model="preacher_curl_toy_arm">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="960" offheight="720"/>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.25 0.25 0.25"/>
  </visual>
  <default>
    <geom friction="0.8 0.1 0.1" contype="0" conaffinity="0"/>
    <joint damping="0.08" armature="0.005"/>
  </default>
  <worldbody>
    <light pos="0 -2 3" dir="0 1 -1"/>
    <camera name="overview" pos="0 -2.5 1.2" xyaxes="1 0 0 0 0 1"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.15 0.18 0.22 1"/>
    <geom name="support" type="box" pos="0.15 0 0.85" size="0.18 0.12 0.035"
          euler="0 -0.65 0" rgba="0.30 0.34 0.38 1"/>
    <!-- No shoulder joint: the upper arm is fixed to the world, as on a fixture.
         This is a 1-DOF instructional model, not an anatomical arm asset. -->
    <body name="upper_arm" pos="0.15 0 1.35" euler="0 0.45 0">
      <geom name="upper_arm_visual" type="capsule" fromto="0 0 0 0 0 -0.30"
            size="0.045" mass="1.8" rgba="0.56 0.65 0.74 1"/>
      <body name="forearm" pos="0 0 -0.30">
        <joint name="elbow" type="hinge" axis="0 1 0"
               range="0.2617993878 2.3561944902"/>
        <geom name="forearm_visual" type="capsule" fromto="0 0 0 0 0 -0.27"
              size="0.035" mass="1.0" rgba="0.75 0.81 0.86 1"/>
        <site name="elbow_site" pos="0 0 0" size="0.012" rgba="0.9 0.7 0.2 1"/>
        <site name="hand_site" pos="0 0 -0.29" size="0.015"/>
        <body name="payload" pos="0 0 -0.29">
          <geom name="payload_visual" type="sphere" size="0.055" mass="1.0"
                rgba="0.12 0.15 0.19 1"/>
        </body>
      </body>
    </body>
  </worldbody>
  <!-- Intentionally no actuators. The external series-elastic muscle model
       produces tendon forces; env.py maps those forces into elbow torque. -->
</mujoco>
